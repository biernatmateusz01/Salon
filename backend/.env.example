API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@salon.local
ADMIN_PASSWORD=admin123

# --- Salon info used in reminders ---
SALON_NAME=Salon
SALON_ADDRESS=
DEFAULT_LOCALE=pl

# --- 24h reminders (leave credentials empty to only print messages to the console) ---
REMINDERS_ENABLED=true
REMINDER_HOURS_BEFORE=24

# Email via any SMTP server (Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Salon <no-reply@example.com>"

# SMS via SMSAPI.pl — token from https://ssl.smsapi.pl/react/oauth/manage
SMSAPI_TOKEN=
SMSAPI_FROM=
SMSAPI_TEST=false
